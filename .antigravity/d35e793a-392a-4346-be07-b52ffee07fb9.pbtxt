  file_change {
    absolute_path_uri: "file:///src/components/RecoveryTab.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ShieldCheck, ShieldAlert, Heart, Calendar, Snowflake, Zap } from \'lucide-react\';\n\nexport default function RecoveryTab() {\n  // Assessment questions states\n  const [q1, setQ1] = useState<boolean>(false); // fatigue\n  const [q2, setQ2] = useState<boolean>(false); // mood\n  const [q3, setQ3] = useState<boolean>(false); // HR elevation\n  const [q4, setQ4] = useState<boolean>(false); // sleep\n  const [q5, setQ5] = useState<boolean>(false); // sharp local pain\n\n  // Count positive responses\n  const score = [q1, q2, q3, q4, q5].filter(Boolean).length;\n\n  return (\n    <div id=\"recovery-tab-container\" className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n      \n      {/* Col 1: Interactive Overtraining Assessment Quiz */}\n      <div id=\"overtraining-quiz-card\" className=\"bg-white rounded-xl border border-gray-100 p-6 shadow-xs h-fit space-y-4\">\n        <div className=\"border-b border-gray-100 pb-3\">\n          <h3 className=\"text-base font-semibold text-gray-800 flex items-center gap-2\">\n            <Heart className=\"w-5 h-5 text-red-500\" />\n            Checklist de Preven\303\247\303\243o & Overtraining\n          </h3>\n          <p className=\"text-xs text-gray-500 mt-1\">\n            Marque os sintomas recorrentes nos \303\272ltimos 5-7 dias para verificar seu n\303\255vel de adapta\303\247\303\243o biol\303\263gica \303\240 carga de treinos.\n          </p>\n        </div>\n\n        <div className=\"space-y-4 pt-1\">\n          {/* Q1 */}\n          <label className=\"flex items-start space-x-3 cursor-pointer group text-sm select-none\">\n            <input \n              type=\"checkbox\" \n              checked={q1}\n              onChange={() => setQ1(!q1)}\n              className=\"mt-0.5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer w-4 h-4\"\n            />\n            <div className=\"text-gray-700 group-hover:text-gray-900\">\n              <span className=\"font-semibold block text-xs\">Fadiga Cr\303\264nica Persistente</span>\n              <span className=\"text-[11px] text-gray-400 block leading-tight\">Sensa\303\247\303\243o de pernas pesadas e cansa\303\247o excessivo mesmo nas tarefas di\303\241rias comuns.</span>\n            </div>\n          </label>\n\n          {/* Q2 */}\n          <label className=\"flex items-start space-x-3 cursor-pointer group text-sm select-none\">\n            <input \n              type=\"checkbox\" \n              checked={q2}\n              onChange={() => setQ2(!q2)}\n              className=\"mt-0.5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer w-4 h-4\"\n            />\n            <div className=\"text-gray-700 group-hover:text-gray-900\">\n              <span className=\"font-semibold block text-xs\">Altera\303\247\303\265es Sistem\303\241ticas de Humor</span>\n              <span className=\"text-[11px] text-gray-400 block leading-tight\">Irritabilidade elevada, ansiedade ou falta de motiva\303\247\303\243o generalizada para treinar.</span>\n            </div>\n          </label>\n\n          {/* Q3 */}\n          <label className=\"flex items-start space-x-3 cursor-pointer group text-sm select-none\">\n            <input \n              type=\"checkbox\" \n              checked={q3}\n              onChange={() => setQ3(!q3)}\n              className=\"mt-0.5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer w-4 h-4\"\n            />\n            <div className=\"text-gray-700 group-hover:text-gray-900\">\n              <span className=\"font-semibold block text-xs\">FC de Repouso Matinal Elevada</span>\n              <span className=\"text-[11px] text-gray-400 block leading-tight\">Sua frequ\303\252ncia card\303\255aca ao acordar est\303\241 &gt; 5-7 bpm acima do seu hist\303\263rico comum.</span>\n            </div>\n          </label>\n\n          {/* Q4 */}\n          <label className=\"flex items-start space-x-3 cursor-pointer group text-sm select-none\">\n            <input \n              type=\"checkbox\" \n              checked={q4}\n              onChange={() => setQ4(!q4)}\n              className=\"mt-0.5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer w-4 h-4\"\n            />\n            <div className=\"text-gray-700 group-hover:text-gray-900\">\n              <span className=\"font-semibold block text-xs\">Sono Prejudicado ou Agitado</span>\n              <span className=\"text-[11px] text-gray-400 block leading-tight\">Dificuldade para iniciar o sono, m\303\272ltiplos despertares noturnos ou suores incomuns.</span>\n            </div>\n          </label>\n\n          {/* Q5 - Sharp Local Pain */}\n          <label className=\"flex items-start space-x-3 cursor-pointer group text-sm select-none border-t border-gray-100/60 pt-3\">\n            <input \n              type=\"checkbox\" \n              checked={q5}\n              onChange={() => setQ5(!q5)}\n              className=\"mt-0.5 rounded border-rose-300 text-rose-600 focus:ring-rose-500 cursor-pointer w-4 h-4\"\n            />\n            <div className=\"text-gray-700 group-hover:text-gray-900\">\n              <span className=\"font-semibold block text-xs text-rose-700\">Dor Aguda Localizada Recorrente</span>\n              <span className=\"text-[11px] text-rose-500/80 block leading-tight\">Dor que piora ao pisar (canela, joelho, calcanhar ou tend\303\243o de aquiles).</span>\n            </div>\n          </label>\n        </div>\n      </div>\n\n      {/* Col 2 & 3: Results and Protocols */}\n      <div id=\"recovery-protocols-results\" className=\"lg:col-span-2 space-y-6\">\n        \n        {/* Risk Diagnostic Banner */}\n        <div id=\"diagnostic-result-banner\" className={`rounded-xl p-5 border flex flex-col md:flex-row items-center gap-4 ${\n          score >= 4 || q5\n            ? \'bg-rose-50 border-rose-200 text-rose-900\'\n            : score >= 2\n              ? \'bg-amber-50 border-amber-200 text-amber-900\'\n              : \'bg-emerald-50 border-emerald-200 text-emerald-900\'\n        }`}>\n          <div className=\"shrink-0\">\n            {score >= 4 || q5 ? (\n              <ShieldAlert className=\"w-12 h-12 text-rose-600\" />\n            ) : score >= 2 ? (\n              <ShieldAlert className=\"w-12 h-12 text-amber-600\" />\n            ) : (\n              <ShieldCheck className=\"w-12 h-12 text-emerald-600\" />\n            )}\n          </div>\n          \n          <div className=\"space-y-1 text-center md:text-left\">\n            <div className=\"text-[10px] uppercase font-bold tracking-widest opacity-80\">Risco Adaptativo Diagnosticado</div>\n            <h4 className=\"text-base font-extrabold font-sans\">\n              {score >= 4 || q5 \n                ? \'ALERTA: Risco Muito Alto / Risco de Les\303\243o ou Overtraining\' \n                : score >= 2 \n                  ? \'AVISO: Risco Moderado de Fadiga (Comprometimento Fisiol\303\263gico)\' \n                  : \'Recupera\303\247\303\243o Excelente / \303\223tima Adapta\303\247\303\243o \303\240 Planilha\'}\n            </h4>\n            <p className=\"text-xs leading-relaxed opacity-90 max-w-xl font-sans\">\n              {score >= 4 || q5\n                ? \'Seu corpo est\303\241 exibindo m\303\272ltiplos sinais cl\303\255nicos de sobrecarga fisiol\303\263gica e estrutural. Ignorar estes sintomas pode resultar em les\303\265es inflamat\303\263rias severas ou s\303\255ndrome de frustra\303\247\303\243o sist\303\252mica.\'\n                : score >= 2\n                  ? \'Voc\303\252 est\303\241 no limite de fadiga produtiva. Sugere-se reduzir o volume dos treinos da pr\303\263xima semana em 20% a 30% ou trocar um dia de rodagem por repouso absoluto, evitando tiros r\303\241pidos temporariamente.\'\n                  : \'Sinal verde! O treinamento est\303\241 sendo absorvido corretamente. Mantenha os seus h\303\241bitos de hidrata\303\247\303\243o e sono profundo atuais para continuar evoluindo de forma cont\303\255nua.\'}\n            </p>\n          </div>\n        </div>\n\n        {/* CLINICAL DOOR WARNINGS GUARD */}\n        {q5 && (\n          <div id=\"critical-medical-guard\" className=\"bg-red-600 text-white rounded-xl p-6 space-y-3 shadow-lg border border-red-700 animate-pulse\">\n            <div className=\"flex items-center space-x-2 border-b border-red-500 pb-2\">\n              <ShieldAlert className=\"w-5 h-5 text-white\" />\n              <h3 className=\"font-extrabold text-sm uppercase font-mono tracking-wider\">\342\232\240 ADVERT\303\212NCIA M\303\211DICA DE SEGURAN\303\207A</h3>\n            </div>\n            <p className=\"text-xs leading-relaxed font-semibold\">\n              CR\303\215TICO: Voc\303\252 relatou DOR AGUDA LOCALIZADA RECORRENTE nas articula\303\247\303\265es, ossos ou tend\303\265es. \n            </p>\n            <p className=\"text-xs leading-relaxed font-sans opacity-95\">\n              Por favor, <strong>interrompa imediatamente todas as atividades de corrida com impacto</strong>. Dores localizadas persistentes podem sinalizar patologias cl\303\255nicas graves, como <strong>fratura por estresse na t\303\255bia, tendinopatia patelar ou estiramentos musculares complexos</strong>. Consulte um m\303\251dico ortopedista ou fisioterapeuta de confian\303\247a antes de cal\303\247ar os t\303\252nis novamente.\n            </p>\n          </div>\n        )}\n\n        {/* Protocolo de Recupera\303\247\303\243o Ativa */}\n        <div id=\"active-recovery-card\" className=\"bg-white rounded-xl border border-gray-100 p-6 shadow-xs space-y-4\">\n          <div className=\"border-b border-gray-100 pb-3\">\n            <h3 className=\"text-base font-semibold text-gray-800 flex items-center gap-2\">\n              <Snowflake className=\"w-4 h-4 text-sky-500\" />\n              Guia Completo de Protocolo de Recupera\303\247\303\243o Ativo\n            </h3>\n            <p className=\"text-xs text-gray-500\">Procedimentos estruturados para acelerar a depura\303\247\303\243o de metab\303\263litos corporais e consolidar a s\303\255ntese de mitoc\303\264ndrias.</p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            \n            {/* Protocol Item 1 */}\n            <div className=\"border border-gray-50 bg-gray-50/40 rounded-lg p-4 space-y-2\">\n              <div className=\"flex items-center space-x-1.5 font-bold text-xs text-indigo-900 uppercase tracking-wide\">\n                <Zap className=\"w-4 h-4 text-emerald-500\" />\n                <span>1. Rodagem Regenerativa Ativa (Easy S1)</span>\n              </div>\n              <p className=\"text-xs text-gray-600 leading-relaxed font-sans\">\n                Realize um trote cont\303\255nuo super-f\303\241cil de 20 a 30 minutos em ritmo de caminhada acelerada ou Z1 card\303\255aco. O objetivo \303\251 unicamente for\303\247ar o bombeamento do m\303\272sculo sem fadig\303\241-lo, limpando o lactato acumulado nas pernas sem gerar estresse inflamat\303\263rio mec\303\242nico.\n              </p>\n            </div>\n\n            {/* Protocol Item 2 */}\n            <div className=\"border border-gray-50 bg-gray-50/40 rounded-lg p-4 space-y-2\">\n              <div className=\"flex items-center space-x-1.5 font-bold text-xs text-indigo-900 uppercase tracking-wide\">\n                <Zap className=\"w-4 h-4 text-emerald-500\" />\n                <span>2. Libera\303\247\303\243o Miofascial Cuidadosa</span>\n              </div>\n              <p className=\"text-xs text-gray-600 leading-relaxed font-sans\">\n                Utilize um rolo de espuma (foam roller) ou uma bola de t\303\252nis sob a sola do p\303\251 (f\303\241scia plantar), panturrilhas, banda iliotibial e gl\303\272teos. Fa\303\247a movimentos lentos e controlados por 45-60 segundos por ponto de dor para soltar pontos gatilho.\n              </p>\n            </div>\n\n            {/* Protocol Item 3 */}\n            <div className=\"border border-gray-50 bg-gray-50/40 rounded-lg p-4 space-y-2\">\n              <div className=\"flex items-center space-x-1.5 font-bold text-xs text-indigo-900 uppercase tracking-wide\">\n                <Zap className=\"w-4 h-4 text-emerald-500\" />\n                <span>3. Alongamento Passivo e Mobilidade</span>\n              </div>\n              <p className=\"text-xs text-gray-600 leading-relaxed font-sans\">\n                Realize alongamentos est\303\241ticos p\303\263s-treino ou em dias de OFF focando na mobilidade de quadril, panturrilhas (s\303\263leo e gastrocn\303\252mio) e isquiotibiais. Mantenha cada postura por 30 segundos, sem pressa, respirando suavemente pelo nariz.\n              </p>\n            </div>\n\n            {/* Protocol Item 4 */}\n            <div className=\"border border-gray-50 bg-gray-50/40 rounded-lg p-4 space-y-2\">\n              <div className=\"flex items-center space-x-1.5 font-bold text-xs text-indigo-900 uppercase tracking-wide\">\n                <Zap className=\"w-4 h-4 text-emerald-500\" />\n                <span>4. Hidrata\303\247\303\243o Profunda Osm\303\263tica</span>\n              </div>\n              <p className=\"text-xs text-gray-600 leading-relaxed font-sans\">\n                Beba aproximadamente 35ml a 40ml de \303\241gua por quilo de peso corporal por dia. Insira uma dose de eletr\303\263litos (s\303\263dio, pot\303\241ssio, magn\303\251sio) em dias quentes para repor os sais eliminados na transpira\303\247\303\243o e evitar c\303\243ibras ou dores musculares tardias.\n              </p>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  );\n}\n"
    }

          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    CONSTRAINT unique_corrida_evento UNIQUE (titulo, data_prova, estado)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED

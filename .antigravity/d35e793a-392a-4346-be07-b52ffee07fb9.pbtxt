          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function calculatePaceZones(vdot: number): PaceZone[] {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Daniels\' training intensities percentages (of VDOT value)"

  file_change {
    absolute_path_uri: "file:///src/components/PlanTab.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { WeekPlan, RunnerState } from \'../types\';\nimport { Calendar, Percent, ShieldCheck, HelpCircle, Flame, ArrowRight, Snowflake } from \'lucide-react\';\n\ninterface PlanTabProps {\n  planWeeks: WeekPlan[];\n  runnerState: RunnerState;\n}\n\nexport default function PlanTab({ planWeeks, runnerState }: PlanTabProps) {\n  const [activeWeekIndex, setActiveWeekIndex] = useState<number>(0);\n  const activeWeek = planWeeks[activeWeekIndex] || planWeeks[0];\n\n  const weeksKeys = [\n    { num: 1, label: \'Sem. 1\', cycle: \'Fase I: Funda\303\247\303\243o\' },\n    { num: 2, label: \'Sem. 2\', cycle: \'Fase I: Constru\303\247\303\243o\' },\n    { num: 3, label: \'Sem. 3\', cycle: \'Fase II: Sobrecarga\' },\n    { num: 4, label: \'Sem. 4\', cycle: \'Fase II: Supercompensar\' },\n    { num: 5, label: \'Sem. 5\', cycle: \'Fase III: Ritmo e Limiar\' },\n    { num: 6, label: \'Sem. 6\', cycle: \'Fase III: Pico Volume\' },\n    { num: 7, label: \'Sem. 7\', cycle: \'Fase IV: VO2M\303\241x\' },\n    { num: 8, label: \'Sem. 8\', cycle: \'Fase IV: Polimento\' },\n  ];\n\n  // Types of workouts badge colors\n  const typeMap: Record<string, { label: string, bg: string, text: string }> = {\n    \'Rest\': { label: \'Descanso / OFF\', bg: \'bg-gray-100 border-gray-200\', text: \'text-gray-600\' },\n    \'Easy\': { label: \'Trote / Rodagem (E)\', bg: \'bg-emerald-50 border-emerald-200\', text: \'text-emerald-700\' },\n    \'Long Run\': { label: \'Treino Longo (LR)\', bg: \'bg-blue-50 border-blue-200\', text: \'text-blue-700\' },\n    \'Threshold\': { label: \'Limiar de Lactato (T)\', bg: \'bg-amber-50 border-amber-200\', text: \'text-amber-700\' },\n    \'Interval\': { label: \'Velocidade / Tiros (I)\', bg: \'bg-rose-50 border-rose-250\', text: \'text-rose-700\' },\n    \'Repetition\': { label: \'Repeti\303\247\303\265es R\303\241pidas (R)\', bg: \'bg-purple-50 border-purple-200\', text: \'text-purple-700\' },\n  };\n\n  const isBeginnerMode = runnerState.level === \'beginner\' || runnerState.weeksActive <= 6;\n  const maxIntervalKm = Math.round(activeWeek.totalVolumeKm * 0.08 * 10) / 10;\n\n  return (\n    <div id=\"plan-tab-container\" className=\"space-y-6\">\n      \n      {/* Top Selector Grid */}\n      <div className=\"bg-white rounded-xl border border-gray-100 p-5 shadow-xs\">\n        <h3 className=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3\">Cronograma de Periodiza\303\247\303\243o (Clique para selecionar a semana)</h3>\n        <div id=\"weeks-selectors-grid\" className=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3\">\n          {weeksKeys.map((w, idx) => {\n            const isSelected = activeWeekIndex === idx;\n            const weekData = planWeeks[idx];\n            const isRegenerativa = idx === 3 || idx === 7;\n\n            return (\n              <button\n                key={w.num}\n                onClick={() => setActiveWeekIndex(idx)}\n                className={`flex flex-col items-center justify-center p-3 rounded-xl border transition text-left cursor-pointer ${\n                  isSelected \n                    ? \'bg-indigo-600 border-indigo-600 text-white shadow-xs\' \n                    : isRegenerativa\n                      ? \'bg-emerald-50/70 border-emerald-200 hover:bg-emerald-50 text-emerald-800\'\n                      : \'bg-gray-50 border-gray-200 hover:border-gray-300 text-gray-700\'\n                }`}\n              >\n                <div className=\"text-[11px] uppercase tracking-wider opacity-85 font-mono font-bold\">Semana {w.num}</div>\n                <div className=\"text-base font-extrabold font-sans mt-0.5\">{weekData ? `${weekData.totalVolumeKm} km` : `${w.label}`}</div>\n                <div className={`text-[10px] mt-1 text-center font-medium ${isSelected ? \'text-indigo-200\' : \'text-gray-400\'}`}>\n                  {isRegenerativa ? \'\360\237\222\241 Regenerativa\' : \'\342\232\241 Building\'}\n                </div>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Week Title & Metadata */}\n      <div id=\"week-metrics-overview\" className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        \n        {/* Metric 1 */}\n        <div className=\"bg-slate-905 bg-slate-900 border border-slate-800 text-white rounded-xl p-5 shadow-xs flex items-center justify-between col-span-1 md:col-span-2\">\n          <div className=\"space-y-1\">\n            <div className=\"text-xs text-indigo-300 uppercase tracking-wider font-mono\">Fase & Objetivo da Semana {activeWeek.weekNum}</div>\n            <h2 className=\"text-2xl font-black text-slate-100 flex items-center gap-2\">\n              <Calendar className=\"w-5 h-5 text-indigo-400\" />\n              {activeWeek.periodLabel}\n            </h2>\n            <div className=\"flex flex-wrap items-center gap-3 mt-2 text-xs text-slate-300\">\n              <div className=\"bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-md\">\n                Esfor\303\247o de Carga: <strong>{activeWeek.intensityLevel}</strong>\n              </div>\n              <div className=\"bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-md\">\n                Volume Semanal: <strong>{activeWeek.totalVolumeKm} km</strong>\n              </div>\n              {activeWeek.weekNum > 1 && (\n                <div className={`px-2.5 py-1 rounded-md font-semibold border ${\n                  activeWeek.ratioChange > 10 \n                    ? \'bg-rose-950/40 border-rose-800 text-rose-300\' \n                    : activeWeek.ratioChange < 0\n                      ? \'bg-emerald-950/40 border-emerald-800 text-emerald-300\'\n                      : \'bg-indigo-950/40 border-indigo-800 text-indigo-300\'\n                }`}>\n                  Frequ\303\252ncia de Volume: <strong>{activeWeek.ratioChange > 0 ? \'+\' : \'\'}{activeWeek.ratioChange}%</strong>\n                </div>\n              )}\n            </div>\n          </div>\n          <div className=\"hidden lg:block border-l border-slate-800 pl-6 shrink-0\">\n            <div className=\"text-right\">\n              <span className=\"text-[10px] text-slate-400 block font-semibold\">TETO SEMANAL DE VELOCIDADE</span>\n              <span className=\"text-lg font-mono font-bold text-indigo-300\">{maxIntervalKm} km m\303\241x de tiros</span>\n              <span className=\"text-[9px] text-slate-500 block\">Restri\303\247\303\243o estrita de 8% volume</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Safety Validation Summary */}\n        <div id=\"plan-safety-validation-card\" className=\"bg-white rounded-xl border border-gray-100 p-5 shadow-xs space-y-3.5\">\n          <div className=\"flex items-center space-x-2 text-indigo-800 font-semibold text-sm\">\n            <ShieldCheck className=\"w-5 h-5 text-emerald-500 shrink-0\" />\n            <span>Valida\303\247\303\265es de Seguran\303\247a</span>\n          </div>\n\n          <div className=\"space-y-2 text-xs text-gray-600 font-sans leading-relaxed\">\n            <div className=\"flex items-center justify-between pb-1.5 border-b border-gray-100/50\">\n              <span>N\303\255vel de Atleta Ajustado:</span>\n              <strong className=\"capitalize text-gray-800\">{runnerState.level}</strong>\n            </div>\n\n            <div className=\"flex items-center justify-between pb-1.5 border-b border-gray-100/50\">\n              <span>Restri\303\247\303\243o Alta Intensidade:</span>\n              <span className={`px-2 py-0.2 rounded text-[10px] font-bold ${isBeginnerMode ? \'bg-amber-100 text-amber-800\' : \'bg-emerald-100 text-emerald-800\'}`}>\n                {isBeginnerMode ? \'Iniciante Protegido (S1-S6)\' : \'Liberada\'}\n              </span>\n            </div>\n\n            <div className=\"flex items-center justify-between\">\n              <span>Teto de Tiros VO2M\303\241x (8%):</span>\n              <span className=\"font-bold font-mono text-indigo-700\">{maxIntervalKm} km</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Daily Workouts Calendar List */}\n      <div id=\"daily-workouts-list\" className=\"space-y-4\">\n        <h3 className=\"text-base font-bold text-gray-800\">Cronograma Di\303\241rio Detalhado</h3>\n        \n        <div id=\"workouts-grid-days\" className=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-7 gap-4\">\n          {activeWeek.workouts.map(wo => {\n            const badge = typeMap[wo.type] || { label: wo.type, bg: \'bg-gray-100 border-gray-200\', text: \'text-gray-600\' };\n            const isOff = wo.type === \'Rest\';\n\n            return (\n              <div \n                key={wo.dayName}\n                className={`border rounded-xl p-4 transition flex flex-col justify-between ${\n                  isOff \n                    ? \'bg-gray-50/55 border-gray-200/55 opacity-80 xl:col-span-1\' \n                    : \'bg-white border-gray-100 hover:border-indigo-200 hover:shadow-xs xl:col-span-1\'\n                }`}\n                style={{ minHeight: \'340px\' }}\n              >\n                {/* Header */}\n                <div className=\"space-y-2\">\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"font-extrabold text-sm text-gray-700 uppercase font-mono tracking-wider\">{wo.dayName}</span>\n                    <span className={`border text-[9px] px-2 py-0.5 rounded font-extrabold tracking-tight ${badge.bg} ${badge.text}`}>\n                      {badge.label}\n                    </span>\n                  </div>\n\n                  <h4 className=\"font-bold text-xs text-slate-800 font-sans line-clamp-2 leading-snug\">{wo.title}</h4>\n                </div>\n\n                {/* Card middle: Workout distance / intensity */}\n                <div className=\"my-3.5 pt-3.5 border-t border-gray-100/50 space-y-1 bg-gray-50/35 p-2 rounded-lg\">\n                  <div className=\"flex justify-between items-center text-[11px] text-gray-500\">\n                    <span>Metragem:</span>\n                    <strong className=\"text-slate-800 font-mono font-bold\">{isOff ? \'OFF\' : `${wo.distanceKm} km`}</strong>\n                  </div>\n                  <div className=\"flex justify-between items-center text-[10px] text-gray-500\">\n                    <span>Intensidade:</span>\n                    <span className=\"text-slate-700 font-medium truncate max-w-[120px]\" title={wo.intensity}>{wo.intensity}</span>\n                  </div>\n                </div>\n\n                {/* Description */}\n                <div className=\"mt-auto\">\n                  <p className=\"text-[11px] text-gray-600 leading-relaxed font-sans line-clamp-5\">\n                    {wo.description}\n                  </p>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n    </div>\n  );\n}\n"
    }

          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    link_inscricao TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    fonte_origem TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {

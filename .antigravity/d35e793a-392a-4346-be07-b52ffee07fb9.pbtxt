        }
        lines {
          text: "                    <p className=\"text-[11px] text-slate-400 mt-0.5 leading-relaxed\">Apoiar as pontas dos p\303\251s no degrau, descer ao m\303\241ximo e subir rapidamente contraindo forte a panturrilha. 3 s\303\251ries de 15 reps controladas.</p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT

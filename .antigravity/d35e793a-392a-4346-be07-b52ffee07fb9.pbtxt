      replacement_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { ChatMessage, RunnerState, WeekPlan } from \'../types\';\nimport { Send, User, Sparkles, MessageCircle, RefreshCw, AlertCircle } from \'lucide-react\';\n\ninterface CoachChatProps {\n  runnerState: RunnerState;\n  activePlan: WeekPlan[];\n}\n\nexport default function CoachChat({ runnerState, activePlan }: CoachChatProps) {\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: \'welcome\',\n      role: \'assistant\',\n      text: `Ol\303\241, atleta! Eu sou o seu **Treinador Virtual VDOT**. \n\nEstou aqui para te orientar em busca de novas marcas pessoais, calculando suas zonas espec\303\255ficas com base na metodologia de Jack Daniels!\n\nVoc\303\252 pode me perguntar sobre:\n- **Testes**: Avaliar o seu teste de Cooper ou de 2400m para atualizar o seu VO2M\303\241x e VDOT. (Comando 3)\n- **Equival\303\252ncia**: Prever de forma r\303\241pida sua equival\303\252ncia te\303\263rica em outras dist\303\242ncias. (Comando 4)\n- **Cansa\303\247o & Dor**: Dicas de preven\303\247\303\243o contra overtraining ou o que fazer caso sinta dores agudas. (Comando 5)\n\nComo posso te ajudar no seu treino hoje?`,\n      timestamp: new Date().toLocaleTimeString(\'pt-BR\', { hour: \'2-digit\', minute: \'2-digit\' })\n    }\n  ]);\n\n  const [inputText, setInputText] = useState<string>(\'\');\n  const [loading, setLoading] = useState<boolean>(false);\n  const messagesEndRef = useRef<HTMLDivElement | null>(null);\n\n  // Auto-scroll to bottom of chat\n  const scrollToBottom = () => {\n    messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\n  };\n\n  useEffect(() => {\n    scrollToBottom();\n  }, [messages, loading]);\n\n  const handleSendMessage = async (textToSend: string) => {\n    if (!textToSend.trim() || loading) return;\n\n    const userMsg: ChatMessage = {\n      id: Date.now().toString(),\n      role: \'user\',\n      text: textToSend,\n      timestamp: new Date().toLocaleTimeString(\'pt-BR\', { hour: \'2-digit\', minute: \'2-digit\' })\n    };\n\n    setMessages(prev => [...prev, userMsg]);\n    setInputText(\'\');\n    setLoading(true);\n\n    // Format current training plan details for the AI coach context\n    const currentPlanSummary = activePlan.map(w => \n      `Semana ${w.weekNum} [${w.periodLabel}]: Volume ${w.totalVolumeKm}km. Intensidade: ${w.intensityLevel}.`\n    ).join(\'\\n\');\n\n    try {\n      const response = await fetch(\'/api/coach\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          messages: [...messages, userMsg].map(m => ({ role: m.role, text: m.text })),\n          runnerState: runnerState,\n          currentPlanSummary: currentPlanSummary\n        })\n      });\n\n      const data = await response.json();\n      \n      const coachMsg: ChatMessage = {\n        id: (Date.now() + 1).toString(),\n        role: \'assistant\',\n        text: data.message,\n        timestamp: new Date().toLocaleTimeString(\'pt-BR\', { hour: \'2-digit\', minute: \'2-digit\' })\n      };\n\n      setMessages(prev => [...prev, coachMsg]);\n    } catch (err: any) {\n      console.error(err);\n      const errMsg: ChatMessage = {\n        id: \'error\',\n        role: \'assistant\',\n        text: \'\342\232\240\357\270\217 **Ops, erro de rede!** N\303\243o consegui me conectar ao servidor do Treinador IA. Por favor, verifique se seu servidor Express de desenvolvimento est\303\241 rodando.\',\n        timestamp: new Date().toLocaleTimeString(\'pt-BR\', { hour: \'2-digit\', minute: \'2-digit\' })\n      };\n      setMessages(prev => [...prev, errMsg]);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleQuickTrigger = (text: string) => {\n    handleSendMessage(text);\n  };\n\n  const handleResetChat = () => {\n    setMessages([\n      {\n        id: \'welcome\',\n        role: \'assistant\',\n        text: `Conversa reiniciada. Eu sou o seu **Treinador VDOT**. \n\nLembre-se que as minhas estimativas utilizam o seu estado atl\303\251tico atual:\n- **N\303\255vel**: ${runnerState.level}\n- **VDOT**: ${runnerState.currentVdot.toFixed(1)}\n- **Volume**: ${runnerState.weeklyVolume} km/semana\n\nComo voc\303\252 est\303\241 se sentindo fisicamente para o treino de hoje?`,\n        timestamp: new Date().toLocaleTimeString(\'pt-BR\', { hour: \'2-digit\', minute: \'2-digit\' })\n      }\n    ]);\n  };\n\n  return (\n    <div id=\"coach-chat-container\" className=\"bg-slate-950 text-slate-100 rounded-2xl flex flex-col h-[640px] shadow-xl overflow-hidden border border-slate-800\">\n      \n      {/* Chat Header */}\n      <div className=\"bg-slate-900 px-5 py-4 border-b border-slate-800 flex items-center justify-between shrink-0\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"bg-indigo-600/35 p-2 rounded-lg border border-indigo-500/30\">\n            <Sparkles className=\"w-4 h-4 text-indigo-400\" />\n          </div>\n          <div>\n            <h3 className=\"font-extrabold text-sm text-white\">Treinador IA VDOT</h3>\n            <span className=\"text-[10px] text-emerald-400 flex items-center gap-1\">\n              <span className=\"w-1.5 h-1.5 bg-emerald-400 rounded-full animate-ping\" />\n              Sincronizado com os dados acima\n            </span>\n          </div>\n        </div>\n        \n        <button \n          onClick={handleResetChat}\n          title=\"Reiniciar chat\"\n          className=\"text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition\"\n        >\n          <RefreshCw className=\"w-4 h-4\" />\n        </button>\n      </div>\n\n      {/* Messages Scroll Area */}\n      <div className=\"flex-1 p-5 overflow-y-auto space-y-4 scroll-smooth\">\n        {messages.map(msg => {\n          const isUser = msg.role === \'user\';\n          return (\n            <div \n              key={msg.id}\n              className={`flex items-start gap-3 ${isUser ? \'justify-end\' : \'justify-start\'}`}\n            >\n              {!isUser && (\n                <div className=\"bg-indigo-600 shrink-0 p-1.5 rounded-lg text-white font-bold text-xs mt-0.5\">\n                  T\n                </div>\n              )}\n\n              <div className={`flex flex-col max-w-[85%] ${isUser ? \'items-end\' : \'items-start\'}`}>\n                <div className={`p-4 rounded-2xl text-sm leading-relaxed ${\n                  isUser \n                    ? \'bg-indigo-600 text-white rounded-tr-none\' \n                    : \'bg-slate-900 border border-slate-800 text-slate-200 rounded-tl-none\'\n                }`}>\n                  {renderCustomMarkdown(msg.text)}\n                </div>\n                <span className=\"text-[9px] text-slate-500 mt-1 font-mono\">{msg.timestamp}</span>\n              </div>\n\n              {isUser && (\n                <div className=\"bg-slate-800 shrink-0 p-1.5 rounded-lg text-slate-400 mt-0.5\">\n                  <User className=\"w-3.5 h-3.5\" />\n                </div>\n              )}\n            </div>\n          );\n        })}\n\n        {loading && (\n          <div className=\"flex items-start gap-3 justify-start\">\n            <div className=\"bg-indigo-600 shrink-0 p-1.5 rounded-lg text-white font-bold text-xs mt-0.5\">\n              T\n            </div>\n            <div className=\"bg-slate-900 border border-slate-800 p-4 rounded-2xl text-sm text-slate-400 rounded-tl-none flex items-center space-x-2\">\n              <span className=\"w-2 h-2 bg-slate-500 rounded-full animate-bounce delay-75\" />\n              <span className=\"w-2 h-2 bg-slate-500 rounded-full animate-bounce delay-150\" />\n              <span className=\"w-2 h-2 bg-slate-500 rounded-full animate-bounce delay-300\" />\n              <span className=\"text-xs font-mono ml-2\">Treinador elaborando planilha...</span>\n            </div>\n          </div>\n        )}\n        <div ref={messagesEndRef} />\n      </div>\n\n      {/* Suggested Fast Triggers */}\n      <div className=\"px-4 py-2 bg-slate-900/40 border-t border-slate-900 overflow-x-auto whitespace-nowrap scrollbar-none flex gap-2 shrink-0\">\n        <button \n          onClick={() => handleQuickTrigger(\'Como deve ser a progress\303\243o de volume (km) e intensidade?\')}\n          className=\"bg-slate-900 border border-slate-800 hover:border-indigo-500 px-3 py-1.5 rounded-lg text-xs text-slate-300 hover:text-white transition shrink-0 cursor-pointer\"\n        >\n          \360\237\223\210 Volume vs Intensidade\n        </button>\n        <button \n          onClick={() => handleQuickTrigger(\'Fiz o teste de Cooper e corri 2800 metros. Calcular meu VO2 e VDOT, por favor.\')}\n          className=\"bg-slate-900 border border-slate-800 hover:border-indigo-500 px-3 py-1.5 rounded-lg text-xs text-slate-300 hover:text-white transition shrink-0 cursor-pointer\"\n        >\n          \360\237\217\203 Calcular Cooper 2800m\n        </button>\n        <button \n          onClick={() => handleQuickTrigger(\'Se eu corro 5k em 22:30, quanto fa\303\247o nos 10k e na meia maratona?\')}\n          className=\"bg-slate-900 border border-slate-800 hover:border-indigo-500 px-3 py-1.5 rounded-lg text-xs text-slate-300 hover:text-white transition shrink-0 cursor-pointer\"\n        >\n          \342\217\261\357\270\217 Equival\303\252ncia 5k (22min)\n        </button>\n        <button \n          onClick={() => handleQuickTrigger(\'Sinto fortes dores na canela direita ao treinar, o que devo fazer?\')}\n          className=\"bg-slate-900 border border-rose-800/80 hover:border-rose-500 px-3 py-1.5 rounded-lg text-xs text-rose-300 hover:text-white transition shrink-0 cursor-pointer\"\n        >\n          \360\237\232\250 Canela inflamada (Dor aguda!)\n        </button>\n        <button \n          onClick={() => handleQuickTrigger(\'Estou exausto e me sentindo com sintomas de overtraining. Como recuperar?\')}\n          className=\"bg-slate-900 border border-slate-800 hover:border-indigo-500 px-3 py-1.5 rounded-lg text-xs text-slate-300 hover:text-white transition shrink-0 cursor-pointer\"\n        >\n          \360\237\224\213 Fadiga & Overtraining\n        </button>\n      </div>\n\n      {/* Input Bar */}\n      <form \n        onSubmit={(e) => {\n          e.preventDefault();\n          handleSendMessage(inputText);\n        }}\n        className=\"bg-slate-900 p-4 border-t border-slate-850 flex gap-2.5 shrink-0\"\n      >\n        <input \n          type=\"text\"\n          value={inputText}\n          onChange={(e) => setInputText(e.target.value)}\n          placeholder=\"Escreva sua mensagem para o Treinador VDOT...\"\n          disabled={loading}\n          className=\"flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 disabled:opacity-50\"\n        />\n        <button \n          type=\"submit\"\n          disabled={!inputText.trim() || loading}\n          className=\"bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-xl transition disabled:opacity-50 shrink-0 cursor-pointer\"\n        >\n          <Send className=\"w-4 h-4\" />\n        </button>\n      </form>\n\n    </div>\n  );\n}\n\n// Inline Markdown parsing elements\nfunction renderCustomMarkdown(text: string) {\n  return text.split(\'\\n\').map((line, i) => {\n    // List item check\n    if (line.trim().startsWith(\'- \')) {\n      return <li key={i} className=\"ml-4 list-disc text-slate-300 leading-relaxed mb-1\">{parseInlineStyles(line.trim().substring(2))}</li>;\n    }\n    if (line.trim().startsWith(\'* \')) {\n      return <li key={i} className=\"ml-4 list-disc text-slate-300 leading-relaxed mb-1\">{parseInlineStyles(line.trim().substring(2))}</li>;\n    }\n    // Heading 3\n    if (line.trim().startsWith(\'### \')) {\n      return <h4 key={i} className=\"text-sm font-extrabold text-white mt-3.5 mb-1 tracking-wide\">{parseInlineStyles(line.trim().substring(4))}</h4>;\n    }\n    // Heading 2\n    if (line.trim().startsWith(\'## \')) {\n      return <h3 key={i} className=\"text-base font-black text-white mt-4 mb-2 tracking-wide border-b border-slate-800 pb-1\">{parseInlineStyles(line.trim().substring(3))}</h3>;\n    }\n    // Standard Paragraph\n    if (line.trim() === \'\') return <div key={i} className=\"h-2\" />;\n    return <p key={i} className=\"text-slate-300 leading-relaxed font-sans mb-1.5\">{parseInlineStyles(line)}</p>;\n  });\n}\n\nfunction parseInlineStyles(line: string) {\n  const parts = line.split(/\\*\\*([^*]+)\\*\\*/g);\n  return parts.map((part, i) => {\n    if (i % 2 === 1) {\n      return <strong key={i} className=\"font-extrabold text-white bg-slate-800/60 px-1 py-0.2 rounded\">{part}</strong>;\n    }\n    return part;\n  });\n}\n"
    }

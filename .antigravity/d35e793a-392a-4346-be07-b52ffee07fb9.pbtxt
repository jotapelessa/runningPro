        }
        lines {
          text: "    { key: \'M\' as const, name: \'Ritmo Maratona (Marathon - M)\', pctRange: \'75% - 84%\', midPct: 80, color: \'text-blue-600 bg-blue-50 border-blue-200\', description: \'Simula o cansa\303\247o acumulado nas pernas; resist\303\252ncia espec\303\255fica de alta quilometragem.\', descriptionSpeed: \'Esfor\303\247o substancial, controlado de longa dura\303\247\303\243o.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { key: \'T\' as const, name: \'Ritmo Limiar (Limiar de Lactato - T)\', pctRange: \'83% - 88%\', midPct: 86, color: \'text-amber-600 bg-amber-50 border-amber-200\', description: \'Zera o balan\303\247o de lactato produzido. Essencial para aumentar a toler\303\242ncia metab\303\263lica ao cansa\303\247o.\', descriptionSpeed: \'Ritmo confortavelmente exaustivo, mantido por at\303\251 40-50 min.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { key: \'I\' as const, name: \'Ritmo de Intervalos (Intervals - VO2Max - I)\', pctRange: \'95% - 100%\', midPct: 97.5, color: \'text-rose-600 bg-rose-50 border-rose-200\', description: \'Tiros estruturados de VO2M\303\241x. Foco no desenvolvimento card\303\255aco e ventilat\303\263rio m\303\241ximo.\', descriptionSpeed: \'Ritmo muito forte de tiro. Esfor\303\247o m\303\241ximo sustent\303\241vel por 3 a 5 min.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { key: \'R\' as const, name: \'Ritmo de Repeti\303\247\303\265es (Repetition - R)\', pctRange: \'105% - 110%\', midPct: 107.5, color: \'text-purple-600 bg-purple-50 border-purple-200\', description: \'Aprimoramento da economia de corrida, mec\303\242nica motora e capacidade anaer\303\263bica desoxigenada.\', descriptionSpeed: \'Ritmo de sprint r\303\241pido com recupera\303\247\303\243o longa. Velocidade pura.\' }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return intensities.map(item => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Solve velocity for the mid intensity"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const VO2_mid = (item.midPct / 100) * vdot;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Quadratic equation coefficients: 0.000104 * v^2 + 0.182258 * v - (4.60 + VO2_mid) = 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const a = 0.000104;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const b = 0.182258;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const c = -(4.60 + VO2_mid);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const v = (-b + Math.sqrt(b * b - 4 * a * c)) / (2 * a); // velocity in m/min"

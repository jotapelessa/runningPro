          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  <span className=\"text-[9px] bg-slate-800 px-2 py-0.5 rounded text-zinc-400 font-mono\">PostgreSQL</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <pre className=\"bg-[#0B0D16] border border-slate-800 p-4 rounded-xl text-emerald-400 overflow-x-auto text-[11px] font-mono leading-normal max-h-[300px]\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{`-- Tabela de Corridas de Rua Centralizada"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE public.corridas ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    titulo TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    cidade TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    estado VARCHAR(10) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    data_prova TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    distancias JSONB NOT NULL DEFAULT \'[]\'::jsonb,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    relevo_url TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    perfil VARCHAR(20) DEFAULT \'moderate\' CHECK (perfil IN (\'flat\', \'moderate\', \'hilly\', \'extreme\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    perfil_detalhes TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    altimetria_ganho TEXT DEFAULT \'+0m\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    vdot_offset NUMERIC(3,2) DEFAULT 0.00,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dicas_atleta TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    link_inscricao TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    fonte_origem TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    quantidade_estimada TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    CONSTRAINT unique_corrida_evento UNIQUE (titulo, data_prova, estado)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- Ativar RLS (Row Level Security) para seguran\303\247a cibern\303\251tica"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "ALTER TABLE public.corridas ENABLE ROW LEVEL SECURITY;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- Pol\303\255tica 1: Leitura P\303\272blica (Qualquer usu\303\241rio do seu app web pode consultar)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE POLICY \"Leitura p\303\272blica livre\" ON public.corridas"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    FOR SELECT TO public USING (true);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- Pol\303\255tica 2: Inser\303\247\303\243o/Atualiza\303\247\303\243o restrita (Somente nossa Fun\303\247\303\243o Serverless do backend)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE POLICY \"Apenas Vercel Backend escreve\" ON public.corridas"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    FOR ALL TO service_role USING (true);`}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }

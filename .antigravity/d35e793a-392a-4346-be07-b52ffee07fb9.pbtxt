        }
        lines {
          text: "          <p className=\"text-slate-300 font-sans leading-relaxed\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            Ap\303\263s aquecimento leve com trote e mobilidade de quadril, realize: "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <strong className=\"text-white\"> 3x20 contatos de cordas</strong> (salto curtinho de 2cm) + "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <strong className=\"text-white\"> 3x6 saltos de l\303\241pis</strong> (verticais sem dobrar joelhos) + "

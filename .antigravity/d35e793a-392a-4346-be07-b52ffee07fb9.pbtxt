      target_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;650;700;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", system-ui, sans-serif;\n  --font-display: \"Space Grotesk\", sans-serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n\n  /* Repigment standard Tailwind palette to map to Immersive Theme (Dark mode / Neon orange) */\n  --color-indigo-50: rgba(255, 78, 0, 0.08);\n  --color-indigo-100: rgba(255, 78, 0, 0.15);\n  --color-indigo-200: rgba(255, 78, 0, 0.3);\n  --color-indigo-300: rgba(255, 78, 0, 0.5);\n  --color-indigo-400: rgba(255, 78, 0, 0.75);\n  --color-indigo-500: #FF4E00;\n  --color-indigo-600: #FF4E00;\n  --color-indigo-700: #FF4E00;\n  --color-indigo-800: #E03E00;\n  --color-indigo-900: #C02C00;\n  --color-indigo-950: #6B0F00;\n\n  --color-emerald-50: rgba(16, 185, 129, 0.1);\n  --color-emerald-100: rgba(16, 185, 129, 0.2);\n  --color-emerald-200: rgba(16, 185, 129, 0.35);\n  --color-emerald-700: #10B981;\n  --color-emerald-800: #059669;\n\n  --color-white: #121212;\n  --color-gray-50: #050505;\n  --color-gray-100: rgba(255, 255, 255, 0.08);\n  --color-gray-150: rgba(255, 255, 255, 0.12);\n  --color-gray-200: rgba(255, 255, 255, 0.15);\n  --color-gray-300: rgba(255, 255, 255, 0.25);\n  --color-gray-400: rgba(255, 255, 255, 0.45);\n  --color-gray-500: rgba(255, 255, 255, 0.6);\n  --color-gray-600: #D4D4D4;\n  --color-gray-700: #E0E0E0;\n  --color-gray-800: #FFFFFF;\n\n  --color-slate-50: #050505;\n  --color-slate-100: #E0E0E0;\n  --color-slate-200: #D4D4D4;\n  --color-slate-300: rgba(255, 255, 255, 0.6);\n  --color-slate-400: rgba(255, 255, 255, 0.45);\n  --color-slate-500: rgba(255, 255, 255, 0.3);\n  --color-slate-705: #1C1C1E;\n  --color-slate-800: rgba(255, 255, 255, 0.08);\n  --color-slate-900: #0A0A0A;\n  --color-slate-905: #050505;\n  --color-slate-950: #050505;\n}\n\nbody {\n  font-family: var(--font-sans);\n  background-color: #050505;\n  color: #E0E0E0;\n}\n\n/* Ensure clean input visual overrides globally for form fields */\ninput, select, textarea {\n  background-color: #0A0A0A !important;\n  border: 1px solid rgba(255, 255, 255, 0.1) !important;\n  color: #FFFFFF !important;\n}\n\ninput:focus, select:focus, textarea:focus {\n  border-color: #FF4E00 !important;\n  box-shadow: 0 0 10px rgba(255, 78, 0, 0.35) !important;\n  outline: none !important;\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #050505;\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 99px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #FF4E00;\n}\n\n/* Additional visual details */\n.scrollbar-none::-webkit-scrollbar {\n  display: none;\n}\n.scrollbar-none {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}"
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;650;700;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", system-ui, sans-serif;\n  --font-display: \"Space Grotesk\", sans-serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n\n  /* Custom Neon Orange elements for VDOT accent */\n  --color-vdot-orange: #FF4E00;\n  --color-vdot-orange-hover: #E03E00;\n}\n\nbody {\n  font-family: var(--font-sans);\n  background-color: #050505;\n  color: #E0E0E0;\n}\n\n/* Ensure clean input visual overrides globally for form fields */\ninput, select, textarea {\n  background-color: #0A0A0A !important;\n  border: 1px solid rgba(255, 255, 255, 0.1) !important;\n  color: #FFFFFF !important;\n}\n\ninput:focus, select:focus, textarea:focus {\n  border-color: #FF4E00 !important;\n  box-shadow: 0 0 10px rgba(255, 78, 0, 0.35) !important;\n  outline: none !important;\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #050505;\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 99px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #FF4E00;\n}\n\n/* Additional visual details */\n.scrollbar-none::-webkit-scrollbar {\n  display: none;\n}\n.scrollbar-none {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}"

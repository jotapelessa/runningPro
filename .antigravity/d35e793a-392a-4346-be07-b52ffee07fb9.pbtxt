          text: "import { RunnerState, PaceZone, HRZone } from \'../types\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  calculatePaceZones, "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  getKarvonenZones, "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  estimateVO2MaxCooper, "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  estimateVO2Max2400m,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED

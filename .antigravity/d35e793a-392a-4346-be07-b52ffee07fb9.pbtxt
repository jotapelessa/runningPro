        }
        lines {
          text: "-- Ativar RLS (Row Level Security) para seguran\303\247a cibern\303\251tica"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "ALTER TABLE public.corridas ENABLE ROW LEVEL SECURITY;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED

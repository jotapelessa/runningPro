          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return <li key={i} className=\"ml-4 list-disc text-slate-300 leading-relaxed mb-1\">{parseInlineStyles(line.trim().substring(2))}</li>;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (line.trim().startsWith(\'* \')) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return <li key={i} className=\"ml-4 list-disc text-slate-300 leading-relaxed mb-1\">{parseInlineStyles(line.trim().substring(2))}</li>;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Heading 3"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }

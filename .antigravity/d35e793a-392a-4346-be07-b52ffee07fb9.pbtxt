        lines {
          text: "            Mantenha intervalo generoso e interrompa o treino imediatamente ao menor sinal de dores tibiais ou tendinosas."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          </p>"

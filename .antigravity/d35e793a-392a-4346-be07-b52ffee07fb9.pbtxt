        lines {
          text: "    { zone: 1, name: \'Z1 - Recupera\303\247\303\243o Ativa (Active Recovery)\', range: [0.50, 0.60], color: \'text-slate-600 bg-slate-50 border-slate-200\', desc: \'Ideal para circula\303\247\303\243o de metab\303\263litos, restaura\303\247\303\243o neural e rodagens leves p\303\263s-prova.\' },"

          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          computedVo2max = parseFloat((vdotResult * 1.02).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Set reasonable baseline VDOT based on technical level selection"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (level === \'beginner\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        computedVdot = 32.0; // ~5k in 32:00"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        computedVo2max = 32.6;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      } else if (level === \'intermediate\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        computedVdot = 41.8; // ~5k in 22:30"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        computedVo2max = 42.6;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      } else if (level === \'advanced\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        computedVdot = 52.0; // ~5k in 18:30"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        computedVo2max = 53.0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }

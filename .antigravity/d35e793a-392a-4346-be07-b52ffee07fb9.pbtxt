  file_change {
    absolute_path_uri: "file:///src/components/CalculatorTab.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { RunnerState, PaceZone, HRZone } from \'../types\';\nimport { \n  calculatePaceZones, \n  getKarvonenZones, \n  estimateVO2MaxCooper, \n  estimateVO2Max2400m,\n  calculateVDOT\n} from \'../lib/vdot\';\nimport { Heart, ShieldAlert, Award, ChevronRight, Gauge, Timer, Flame } from \'lucide-react\';\n\ninterface CalculatorTabProps {\n  runnerState: RunnerState;\n  setRunnerState: React.Dispatch<React.SetStateAction<RunnerState>>;\n  paceZones: PaceZone[];\n  hrZones: HRZone[];\n}\n\nexport default function CalculatorTab({ \n  runnerState, \n  setRunnerState, \n  paceZones, \n  hrZones \n}: CalculatorTabProps) {\n\n  // Cooper State\n  const [cooperMeters, setCooperMeters] = useState<number>(2600);\n  const [cooperVO2, setCooperVO2] = useState<number | null>(null);\n  const [cooperVdot, setCooperVdot] = useState<number | null>(null);\n\n  // 2400m State\n  const [test2400Min, setTest2400Min] = useState<number>(11);\n  const [test2400Sec, setTest2400Sec] = useState<number>(30);\n  const [test2400VO2, setTest2400VO2] = useState<number | null>(null);\n  const [test2400Vdot, setTest2400Vdot] = useState<number | null>(null);\n\n  // Direct edit VDOT\n  const [directVdot, setDirectVdot] = useState<number>(runnerState.currentVdot);\n\n  const handleApplyCooper = () => {\n    const vo2 = estimateVO2MaxCooper(cooperMeters);\n    const vdot = calculateVDOT(cooperMeters, 12 * 60);\n    setCooperVO2(vo2);\n    setCooperVdot(vdot);\n    \n    // Update state\n    setRunnerState(prev => ({\n      ...prev,\n      currentVdot: parseFloat(vdot.toFixed(2)),\n      currentVo2max: parseFloat(vo2.toFixed(2)),\n      history: [\n        {\n          id: Date.now().toString(),\n          date: new Date().toLocaleDateString(\'pt-BR\'),\n          type: \'cooper\',\n          value: cooperMeters,\n          vo2max: parseFloat(vo2.toFixed(2)),\n          vdot: parseFloat(vdot.toFixed(2))\n        },\n        ...prev.history\n      ]\n    }));\n  };\n\n  const handleApply2400 = () => {\n    const totalSec = (test2400Min * 60) + test2400Sec;\n    const vo2 = estimateVO2Max2400m(totalSec);\n    const vdot = calculateVDOT(2400, totalSec);\n    setTest2400VO2(vo2);\n    setTest2400Vdot(vdot);\n\n    setRunnerState(prev => ({\n      ...prev,\n      currentVdot: parseFloat(vdot.toFixed(2)),\n      currentVo2max: parseFloat(vo2.toFixed(2)),\n      history: [\n        {\n          id: Date.now().toString(),\n          date: new Date().toLocaleDateString(\'pt-BR\'),\n          type: \'2400m\',\n          value: totalSec,\n          vo2max: parseFloat(vo2.toFixed(2)),\n          vdot: parseFloat(vdot.toFixed(2))\n        },\n        ...prev.history\n      ]\n    }));\n  };\n\n  const handleApplyDirectVdot = () => {\n    if (directVdot < 10 || directVdot > 90) return;\n    setRunnerState(prev => ({\n      ...prev,\n      currentVdot: parseFloat(directVdot.toFixed(2)),\n      // VDOT roughly approximates VO2Max\n      currentVo2max: parseFloat((directVdot * 1.02).toFixed(2)),\n      history: [\n        {\n          id: Date.now().toString(),\n          date: new Date().toLocaleDateString(\'pt-BR\'),\n          type: \'vdot_direct\',\n          value: directVdot,\n          vo2max: parseFloat((directVdot * 1.02).toFixed(2)),\n          vdot: parseFloat(directVdot.toFixed(2))\n        },\n        ...prev.history\n      ]\n    }));\n  };\n\n  const maxIntervalKm = Math.round(runnerState.weeklyVolume * 0.08 * 10) / 10;\n\n  return (\n    <div id=\"calculator-tab-container\" className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n      \n      {/* Col 1: Runner Profile Controls */}\n      <div id=\"runner-profile-section\" className=\"lg:col-span-1 space-y-6\">\n        <div id=\"card-configs-running\" className=\"bg-white rounded-xl border border-gray-100 p-6 shadow-xs\">\n          <div className=\"flex items-center space-x-2 border-b border-gray-100 pb-4 mb-4\">\n            <Gauge className=\"w-5 h-5 text-indigo-600\" />\n            <h2 className=\"text-lg font-semibold text-gray-800\">Par\303\242metros do Atleta</h2>\n          </div>\n\n          <div className=\"space-y-4\">\n            {/* Level Selector */}\n            <div>\n              <label className=\"block text-sm font-medium text-gray-700 mb-1\">N\303\255vel T\303\251cnico</label>\n              <select \n                value={runnerState.level} \n                onChange={(e) => setRunnerState(prev => ({ ...prev, level: e.target.value as any }))}\n                className=\"w-full rounded-lg border border-gray-200 bg-gray-50 p-2 text-sm text-gray-800 focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"beginner\">Iniciante (Beginner)</option>\n                <option value=\"intermediate\">Intermedi\303\241rio (Intermediate)</option>\n                <option value=\"advanced\">Avan\303\247ado (Advanced)</option>\n              </select>\n            </div>\n\n            {/* Weekly Volume Input */}\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-sm font-medium text-gray-700 mb-1\">Volume (Km/Sem.)</label>\n                <input \n                  type=\"number\" \n                  value={runnerState.weeklyVolume}\n                  onChange={(e) => setRunnerState(prev => ({ ...prev, weeklyVolume: Math.max(1, parseFloat(e.target.value) || 0) }))}\n                  className=\"w-full rounded-lg border border-gray-200 bg-gray-50 p-2 text-sm text-gray-800 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-sm font-medium text-gray-700 mb-1\">Semanas Ativo</label>\n                <input \n                  type=\"number\" \n                  value={runnerState.weeksActive}\n                  onChange={(e) => setRunnerState(prev => ({ ...prev, weeksActive: Math.max(0, parseInt(e.target.value) || 0) }))}\n                  className=\"w-full rounded-lg border border-gray-200 bg-gray-50 p-2 text-sm text-gray-800 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n            </div>\n\n            {/* HR Inputs */}\n            <div id=\"heart-rate-inputs\" className=\"grid grid-cols-2 gap-4\">\n              <div>\n                <div className=\"flex items-center space-x-1 mb-1\">\n                  <Heart className=\"w-3.5 h-3.5 text-red-500\" />\n                  <label className=\"block text-xs font-medium text-gray-700\">FC M\303\241xima (bpm)</label>\n                </div>\n                <input \n                  type=\"number\" \n                  value={runnerState.macHR}\n                  onChange={(e) => setRunnerState(prev => ({ ...prev, macHR: Math.max(100, parseInt(e.target.value) || 0) }))}\n                  className=\"w-full rounded-lg border border-gray-200 bg-gray-50 p-2 text-sm text-gray-800 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n              <div>\n                <div className=\"flex items-center space-x-1 mb-1\">\n                  <Heart className=\"w-3.5 h-3.5 text-slate-500\" />\n                  <label className=\"block text-xs font-medium text-gray-700\">FC Repouso (bpm)</label>\n                </div>\n                <input \n                  type=\"number\" \n                  value={runnerState.restHR}\n                  onChange={(e) => setRunnerState(prev => ({ ...prev, restHR: Math.max(30, parseInt(e.target.value) || 0) }))}\n                  className=\"w-full rounded-lg border border-gray-200 bg-gray-50 p-2 text-sm text-gray-800 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n            </div>\n\n            {/* Direct VDOT Override */}\n            <div className=\"pt-2 border-t border-gray-100\">\n              <label className=\"block text-xs font-medium text-gray-500 uppercase tracking-widest mb-1.5\">Ajuste Direto de VDOT</label>\n              <div id=\"direct-vdot-fields\" className=\"flex space-x-2\">\n                <input \n                  type=\"number\" \n                  step=\"0.1\"\n                  value={directVdot}\n                  onChange={(e) => setDirectVdot(parseFloat(e.target.value) || 0)}\n                  className=\"w-full rounded-lg border border-gray-200 bg-gray-50 p-2 text-sm text-gray-800 focus:outline-none focus:border-indigo-500\"\n                  placeholder=\"Ex: 45.3\"\n                />\n                <button \n                  id=\"btn-apply-direct\"\n                  onClick={handleApplyDirectVdot}\n                  className=\"px-4 py-2 bg-indigo-600 text-white font-medium text-xs rounded-lg hover:bg-indigo-700 transition\"\n                >\n                  Aplicar\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Safety Indicators box */}\n        <div id=\"safety-guidelines-box\" className=\"bg-amber-50 border border-amber-200 rounded-xl p-5 space-y-3.5\">\n          <div className=\"flex items-start space-x-2 text-amber-800\">\n            <ShieldAlert className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n            <h3 className=\"font-semibold text-sm\">Diretrizes de Prote\303\247\303\243o Desportiva</h3>\n          </div>\n          \n          <div className=\"space-y-2 text-xs text-amber-900 leading-relaxed\">\n            <div className=\"flex items-start\">\n              <span className=\"text-amber-500 mr-2 font-bold\">\342\200\242</span>\n              <p><strong>Meta de Tiros (Intervalado):</strong> Limite m\303\241ximo de volume em velocidade r\303\241pida ({paces.find(p => p.key === \'I\')?.name.split(\'(\')[0]}) para seu volume atual: <span className=\"bg-amber-100 px-1.5 py-0.5 rounded font-mono font-bold text-amber-900\">{maxIntervalKm} km por treino</span> (m\303\241x 8% do volume semanal).</p>\n            </div>\n            \n            <div className=\"flex items-start\">\n              <span className=\"text-amber-500 mr-2 font-bold\">\342\200\242</span>\n              <p><strong>Iniciantes (Semanas 1 a 6):</strong> N\303\243o realizam tiros de alta intensidade para mitigar traumas repetitivos nas articula\303\247\303\265es.</p>\n            </div>\n\n            <div className=\"flex items-start border-t border-amber-200/55 pt-2\">\n              <span className=\"text-amber-500 mr-2 font-bold\">\342\200\242</span>\n              <p><strong>Aumento simult\303\242neo proibido:</strong> Nunca eleve o volume (km) e a intensidade (acelera\303\247\303\265es) simultaneamente em mais de 10%.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Col 2: Test Calculations */}\n      <div id=\"fitness-testing-section\" className=\"lg:col-span-2 space-y-6\">\n        \n        {/* Active Fitness Dashboard */}\n        <div id=\"active-fitness-banner\" className=\"bg-slate-900 text-white rounded-xl p-6 shadow-sm overflow-hidden flex flex-col md:flex-row items-center justify-between gap-4\">\n          <div className=\"space-y-1 text-center md:text-left\">\n            <div className=\"text-xs text-slate-400 uppercase tracking-widest font-semibold\">Gabarito Fisiol\303\263gico Ativo</div>\n            <div className=\"text-3xl font-extrabold text-white flex items-center justify-center md:justify-start gap-3\">\n              <span>VDOT: {runnerState.currentVdot.toFixed(1)}</span>\n              <span className=\"text-slate-500\">|</span>\n              <span className=\"text-indigo-400 text-2xl font-bold\">VO2M\303\241x: {runnerState.currentVo2max.toFixed(1)}</span>\n            </div>\n            <p className=\"text-xs text-slate-400 font-sans\">\n              Zonas de intensidade recalibradas dinamicamente com base nas leis cardiovasculares do oxig\303\252nio.\n            </p>\n          </div>\n          <div className=\"bg-slate-800/80 px-4 py-3 rounded-xl border border-slate-700/60 flex items-center space-x-3 shrink-0\">\n            <Award className=\"w-10 h-10 text-indigo-400\" />\n            <div>\n              <div className=\"text-xs text-slate-400\">Classifica\303\247\303\243o Prevista</div>\n              <div className=\"text-sm font-semibold capitalize font-sans\">\n                {runnerState.currentVdot >= 55 ? \'Alta Performance\' : runnerState.currentVdot >= 46 ? \'Intermedi\303\241rio Avan\303\247ado\' : runnerState.currentVdot >= 36 ? \'Intermedi\303\241rio Confort\303\241vel\' : \'Iniciante Ativo\'}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Dynamic testing converters */}\n        <div id=\"testing-methods-card\" className=\"bg-white rounded-xl border border-gray-100 p-6 shadow-xs space-y-6\">\n          <div className=\"border-b border-gray-100 pb-4\">\n            <h3 className=\"text-base font-semibold text-gray-800\">C\303\241lculo de VO2M\303\241x via Testes de Campo</h3>\n            <p className=\"text-xs text-gray-500 mt-1\">Insira os resultados obtidos em pista para autocalcular seu VDOT e reformular suas zonas desportivas.</p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {/* Cooper Method */}\n            <div className=\"border border-gray-100 rounded-lg p-4 space-y-4 bg-gray-50/40 hover:border-gray-200 transition\">\n              <div className=\"flex items-center space-x-2 text-indigo-700 font-semibold text-sm\">\n                <Timer className=\"w-4 h-4\" />\n                <span>Teste de Cooper (12 minutos)</span>\n              </div>\n              <p className=\"text-xs text-gray-500 leading-snug\">Corra a maior dist\303\242ncia poss\303\255vel dentro do tempo fixo de 12 minutos.</p>\n              \n              <div>\n                <label className=\"block text-xs text-gray-600 mb-1 font-medium\">Dist\303\242ncia Percorrida (Metros)</label>\n                <div className=\"flex space-x-2\">\n                  <input \n                    type=\"number\"\n                    value={cooperMeters}\n                    step=\"10\"\n                    onChange={(e) => setCooperMeters(parseInt(e.target.value) || 0)}\n                    className=\"w-full rounded-lg border border-gray-200 bg-white p-2 text-sm text-gray-800 focus:outline-none\"\n                  />\n                  <button\n                    onClick={handleApplyCooper}\n                    className=\"px-3 py-2 bg-indigo-600 text-white rounded-md text-xs font-semibold hover:bg-indigo-700 transition shrink-0\"\n                  >\n                    Estimar\n                  </button>\n                </div>\n              </div>\n\n              {cooperVdot !== null && (\n                <div className=\"bg-indigo-50 border border-indigo-100 rounded-lg p-3 text-xs space-y-1\">\n                  <div className=\"font-semibold text-indigo-900\">Resultado Estimado Cooper:</div>\n                  <div className=\"text-gray-700\">VO2M\303\241x: <span className=\"font-bold text-indigo-700\">{cooperVO2?.toFixed(1)}</span> ml/kg/min</div>\n                  <div className=\"text-gray-700\">VDOT correspondente: <span className=\"font-bold text-indigo-700\">{cooperVdot?.toFixed(1)}</span></div>\n                  <div className=\"text-gray-400 text-[10px] italic\">Zonas e calend\303\241rios sincronizados!</div>\n                </div>\n              )}\n            </div>\n\n            {/* 2400m Method */}\n            <div className=\"border border-gray-100 rounded-lg p-4 space-y-4 bg-gray-50/40 hover:border-gray-200 transition\">\n              <div className=\"flex items-center space-x-2 text-indigo-700 font-semibold text-sm\">\n                <Timer className=\"w-4 h-4\" />\n                <span>Teste de 2400 metros</span>\n              </div>\n              <p className=\"text-xs text-gray-500 leading-snug\">Corra a dist\303\242ncia exata de 2,4 km no menor tempo poss\303\255vel.</p>\n              \n              <div className=\"grid grid-cols-2 gap-2\">\n                <div>\n                  <label className=\"block text-xs text-gray-600 mb-1 font-medium\">Minutos</label>\n                  <input \n                    type=\"number\"\n                    value={test2400Min}\n                    onChange={(e) => setTest2400Min(parseInt(e.target.value) || 0)}\n                    className=\"w-full rounded-lg border border-gray-200 bg-white p-2 text-sm text-gray-800 focus:outline-none\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs text-gray-600 mb-1 font-medium\">Segundos</label>\n                  <div className=\"flex space-x-1.5\">\n                    <input \n                      type=\"number\"\n                      value={test2400Sec}\n                      max=\"59\"\n                      onChange={(e) => setTest2400Sec(parseInt(e.target.value) || 0)}\n                      className=\"w-full rounded-lg border border-gray-200 bg-white p-2 text-sm text-gray-800 focus:outline-none\"\n                    />\n                    <button\n                      onClick={handleApply2400}\n                      className=\"px-2.5 py-2 bg-indigo-600 text-white rounded-md text-xs font-semibold hover:bg-indigo-700 transition shrink-0\"\n                    >\n                      Calcular\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {test2400Vdot !== null && (\n                <div className=\"bg-indigo-50 border border-indigo-100 rounded-lg p-3 text-xs space-y-1\">\n                  <div className=\"font-semibold text-indigo-900\">Resultado Estimado 2400m:</div>\n                  <div className=\"text-gray-700\">VO2M\303\241x: <span className=\"font-bold text-indigo-700\">{test2400VO2?.toFixed(1)}</span> ml/kg/min</div>\n                  <div className=\"text-gray-700\">VDOT correspondente: <span className=\"font-bold text-indigo-700\">{test2400Vdot?.toFixed(1)}</span></div>\n                  <div className=\"text-gray-400 text-[10px] italic\">Zonas e calend\303\241rios sincronizados!</div>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Row 2: Tables for Pace and HR */}\n      <div id=\"zones-comparison-tables\" className=\"lg:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-6 pt-2\">\n        \n        {/* Pace Table */}\n        <div id=\"vdot-paces-card\" className=\"bg-white rounded-xl border border-gray-100 p-6 shadow-xs space-y-4\">\n          <div className=\"border-b border-gray-100 pb-3 flex justify-between items-center\">\n            <h3 className=\"text-base font-semibold text-gray-800 flex items-center gap-2\">\n              <Flame className=\"w-4 h-4 text-emerald-500\" />\n              Tabela de Ritmos de Corrida VDOT (Paces)\n            </h3>\n            <span className=\"bg-indigo-50 text-indigo-700 font-mono text-xs px-2 py-0.5 rounded-full font-bold\">VDOT ~ {runnerState.currentVdot}</span>\n          </div>\n\n          <div className=\"space-y-3.5\">\n            {paceZones.map(pz => (\n              <div \n                key={pz.key}\n                className=\"border border-gray-100 rounded-lg p-3.5 flex flex-col md:flex-row md:items-center justify-between gap-3 bg-white hover:shadow-xs transition\"\n              >\n                <div className=\"space-y-1 col-span-2\">\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-indigo-500\" />\n                    <span className=\"font-bold text-sm text-gray-800\">{pz.name}</span>\n                  </div>\n                  <p className=\"text-xs text-gray-500 font-sans leading-relaxed\">{pz.description}</p>\n                  <p className=\"text-[11px] text-indigo-600 font-mono font-medium\">{pz.descriptionSpeed}</p>\n                </div>\n\n                <div className=\"text-right flex md:flex-col justify-between items-center md:items-end shrink-0 border-t md:border-t-0 pt-2 md:pt-0 border-gray-50\">\n                  <span className=\"text-[11px] text-gray-400 uppercase tracking-wider font-mono\">Pace M\303\251dio / Intervalo</span>\n                  <span className=\"font-mono text-base font-bold text-indigo-700\">{pz.paceStr}</span>\n                  <span className=\"text-[10px] text-gray-400 font-mono\">{pz.paceRangeStr}</span>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* HR Karvonen Table */}\n        <div id=\"hr-zones-card\" className=\"bg-white rounded-xl border border-gray-100 p-6 shadow-xs space-y-4\">\n          <div className=\"border-b border-gray-100 pb-3 flex justify-between items-center\">\n            <h3 className=\"text-base font-semibold text-gray-800 flex items-center gap-2\">\n              <Heart className=\"w-4 h-4 text-red-500\" />\n              Zonas de Frequ\303\252ncia Card\303\255aca (Karvonen)\n            </h3>\n            <span className=\"bg-red-50 text-red-700 font-mono text-xs px-2 py-0.5 rounded-full font-bold\">FCR: {runnerState.restHR} / FCm: {runnerState.macHR}</span>\n          </div>\n\n          <div className=\"space-y-3.5\">\n            {hrZones.map(hz => (\n              <div \n                key={hz.zone} \n                className=\"border border-gray-100 rounded-lg p-3.5 flex flex-col md:flex-row md:items-center justify-between gap-3 bg-white hover:shadow-xs transition\"\n              >\n                <div className=\"space-y-1\">\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-red-500\" />\n                    <span className=\"font-bold text-sm text-gray-800\">{hz.name}</span>\n                  </div>\n                  <p className=\"text-xs text-gray-500 font-sans leading-relaxed\">{hz.description}</p>\n                </div>\n\n                <div className=\"text-right flex md:flex-col justify-between items-center md:items-end shrink-0 border-t md:border-t-0 pt-2 md:pt-0 border-gray-50\">\n                  <span className=\"text-[11px] text-gray-400 uppercase tracking-wider font-mono\">Faixa Alvo (% Intensidade)</span>\n                  <span className=\"font-mono text-base font-bold text-red-600\">{hz.hrRangeStr}</span>\n                  <span className=\"text-[10px] text-gray-400 font-mono\">{hz.intensityRange} da FCM de Reserva</span>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  );\n}\n"
    }

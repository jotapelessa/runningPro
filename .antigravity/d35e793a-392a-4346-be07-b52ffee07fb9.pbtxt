    instruction: "Update PredictorTab element colors, card backgrounds, and text states for immersive dark theme integration and clear text readability"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div id=\"predictor-tab-container\" className=\"space-y-6\">\n      \n      {/* Intro Banner */}\n      <div id=\"predictor-info-banner\" className=\"bg-indigo-600 text-white rounded-xl p-6 shadow-xs flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div className=\"space-y-1\">\n          <h2 className=\"text-xl font-bold flex items-center gap-2\">\n            <TrendingUp className=\"w-5 h-5 text-indigo-200\" />\n            Previs\303\243o de Performance e Equival\303\252ncias\n          </h2>\n          <p className=\"text-xs text-indigo-100 max-w-2xl font-sans leading-relaxed\">\n            Com base na sua efici\303\252ncia de oxig\303\252nio de VDOT {vdot.toFixed(1)}, calculamos o tempo teoricamente equivalente que o seu corpo \303\251 fisiologicamente capaz de entregar em diferentes dist\303\242ncias sob condi\303\247\303\265es ideais.\n          </p>\n        </div>\n        <div className=\"bg-indigo-700 px-4 py-2.5 rounded-lg border border-indigo-500/50 text-center shrink-0\">\n          <div className=\"text-[10px] text-indigo-200 uppercase font-semibold\">Coeficiente de Equival\303\252ncia</div>\n          <div className=\"text-xl font-extrabold font-mono text-white\">VDOT {vdot.toFixed(1)}</div>\n        </div>\n      </div>\n\n      {/* Grid of Predictions and Visualizations */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Equivalent performances list (Col 2) */}\n        <div id=\"equivalencies-list-column\" className=\"lg:col-span-2 bg-white rounded-xl border border-gray-100 p-6 shadow-xs space-y-4\">\n          <div className=\"border-b border-gray-100 pb-3\">\n            <h3 className=\"text-base font-semibold text-gray-800\">Tabela de Tempos Equivalentes (Jack Daniels VDOT)</h3>\n            <p className=\"text-xs text-gray-500 mt-1\">Estimativas obtidas atrav\303\251s do balan\303\247o estrito do consumo aer\303\263bico est\303\241vel por tempo de esfor\303\247o.</p>\n          </div>\n\n          <div id=\"predictions-card-grid\" className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {predictions.map(pred => {\n              const currentPaceSec = pred.totalSeconds / (pred.distanceMeters / 1000);\n              // Calculate percent of relative velocity for visual bar\n              const percentBar = Math.round(((maxPaceSec - currentPaceSec) / (maxPaceSec - minPaceSec || 1)) * 105);\n\n              return (\n                <div \n                  key={pred.name} \n                  className=\"border border-gray-100 bg-gray-50/50 hover:bg-white hover:shadow-xs hover:border-gray-200 rounded-lg p-4 space-y-3 transition flex flex-col justify-between\"\n                >\n                  <div className=\"flex justify-between items-start\">\n                    <div>\n                      <div className=\"text-xs font-semibold text-gray-400 font-mono tracking-wider uppercase\">{pred.name}</div>\n                      <div className=\"text-xs text-gray-500 mt-0.5\">{(pred.distanceMeters / 1000).toFixed(2)} km</div>\n                    </div>\n                    <div className=\"bg-indigo-50 text-indigo-700 px-2 py-1 rounded text-xs font-mono font-bold flex items-center space-x-1\">\n                      <Clock className=\"w-3 h-3\" />\n                      <span>{pred.paceStr}</span>\n                    </div>\n                  </div>\n\n                  <div className=\"pt-2\">\n                    <div className=\"text-2xl font-extrabold text-slate-800 font-mono\">{pred.timeStr}</div>\n                  </div>\n\n                  {/* Relative Speed Progress bar */}\n                  <div className=\"space-y-1\">\n                    <div className=\"flex justify-between text-[10px] text-gray-400 font-mono\">\n                      <span>Velocidade Relativa</span>\n                      <span>{Math.round(((1 / currentPaceSec) * 3600000)).toLocaleString()} m/h</span>\n                    </div>\n                    <div className=\"w-full bg-gray-100 rounded-full h-1.5 overflow-hidden\">\n                      <div \n                        className=\"bg-indigo-500 h-1.5 rounded-full\"\n                        style={{ width: `${Math.max(15, Math.min(100, percentBar))}%` }}\n                      />\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Warning and advice section (Col 1) */}\n        <div id=\"predictor-science-guidelines\" className=\"space-y-6\">\n          \n          {/* Important Scientific caveat box */}\n          <div id=\"scientific-warnings-card\" className=\"bg-amber-50/70 border border-amber-200 rounded-xl p-5 space-y-3.5\">\n            <div className=\"flex items-start space-x-2 text-amber-800\">\n              <AlertTriangle className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n              <h3 className=\"font-semibold text-sm\">Advert\303\252ncia Fisiol\303\263gica Importante</h3>\n            </div>\n            \n            <p className=\"text-xs text-amber-900 leading-relaxed font-sans\">\n              As previs\303\265es mostradas acima s\303\243o <strong>equival\303\252ncias fisiol\303\263gicas te\303\263ricas potenciais</strong> baseadas estritamente na capacidade aer\303\263bica estimada (Consumo M\303\241ximo de Oxig\303\252nio do Sistema VDOT).\n            </p>\n\n            <div className=\"border-t border-amber-200/60 pt-3.5 space-y-3 text-xs text-amber-900 leading-relaxed\">\n              <div className=\"flex items-start\">\n                <span className=\"text-amber-500 mr-2 font-bold\">1.</span>\n                <p><strong>Desenvolvimento Muscular:</strong> Um tempo nos 5k n\303\243o se traduz automaticamente em uma maratona similar, a menos que haja semanas de rodagem longa e consolida\303\247\303\243o card\303\255aco-mec\303\242nica espec\303\255fica.</p>\n              </div>\n              <div className=\"flex items-start\">\n                <span className=\"text-amber-500 mr-2 font-bold\">2.</span>\n                <p><strong>Vari\303\241veis do Meio:</strong> Clima quente (&gt; 22\302\260C), umidade relativa alta, subidas acumuladas e atrito do solo reduzem o rendimento de pace VDOT.</p>\n              </div>\n              <div className=\"flex items-start\">\n                <span className=\"text-amber-500 mr-2 font-bold\">3.</span>\n                <p><strong>Estrat\303\251gia de Ritmo:</strong> Erros de pacing (largar muito r\303\241pido nas primeiras fra\303\247\303\265es de prova) invalidam as equa\303\247\303\265es lineares de Jack Daniels.</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Golden Rules of training */}\n          <div className=\"bg-slate-900 text-white rounded-xl p-5 space-y-4 shadow-sm border border-slate-800\">\n            <div className=\"flex items-center space-x-2 border-b border-slate-800 pb-3\">\n              <ShieldCheck className=\"w-5 h-5 text-emerald-400\" />\n              <h3 className=\"font-bold text-sm\">Leis do Treinamento VDOT</h3>\n            </div>\n\n            <div className=\"space-y-3 text-xs leading-relaxed text-slate-300\">\n              <div>\n                <span className=\"block font-semibold text-white\">Regra 1: Evite o \"Tudo de Uma Vez\"</span>\n                <p className=\"text-slate-400\">Jamais eleve o volume corporal (km/semana) e os treinos de alta velocidade (intensidade) simultaneamente em mais de 10%.</p>\n              </div>\n\n              <div>\n                <span className=\"block font-semibold text-white\">Regra 2: Intensidade pelo VDOT atual</span>\n                <p className=\"text-slate-400\">Sempre treine nos ritmos do seu VDOT atual, e n\303\243o nos ritmos de onde voc\303\252 deseja chegar no futuro.</p>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>"
        replacement_content: "  return (\n    <div id=\"predictor-tab-container\" className=\"space-y-6\">\n      \n      {/* Intro Banner */}\n      <div id=\"predictor-info-banner\" className=\"bg-[#0A0A0A] border border-white/10 text-white rounded-2xl p-6 shadow-lg flex flex-col md:flex-row items-center justify-between gap-4\">\n        <div className=\"space-y-1\">\n          <h2 className=\"text-lg font-bold flex items-center gap-2 font-display uppercase tracking-wider text-white\">\n            <TrendingUp className=\"w-5 h-5 text-vdot-orange\" />\n            Previs\303\243o de Performance e Equival\303\252ncias\n          </h2>\n          <p className=\"text-xs text-slate-300 max-w-2xl font-sans leading-relaxed\">\n            Com base na sua efici\303\252ncia de oxig\303\252nio de VDOT {vdot.toFixed(1)}, calculamos o tempo teoricamente equivalente que o seu corpo \303\251 fisiologicamente capaz de entregar em diferentes dist\303\242ncias sob condi\303\247\303\265es ideais.\n          </p>\n        </div>\n        <div className=\"bg-white/5 px-4 py-2.5 rounded-xl border border-white/10 text-center shrink-0\">\n          <div className=\"text-[10px] text-slate-400 uppercase font-bold tracking-wider\">Coeficiente de Equival\303\252ncia</div>\n          <div className=\"text-lg font-black font-mono text-vdot-orange\">VDOT {vdot.toFixed(1)}</div>\n        </div>\n      </div>\n\n      {/* Grid of Predictions and Visualizations */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Equivalent performances list (Col 2) */}\n        <div id=\"equivalencies-list-column\" className=\"lg:col-span-2 bg-[#0A0A0A] rounded-2xl border border-white/10 p-6 shadow-xl space-y-4\">\n          <div className=\"border-b border-white/10 pb-3\">\n            <h3 className=\"text-sm font-bold text-white uppercase tracking-wider font-display\">Tabela de Tempos Equivalentes (Jack Daniels VDOT)</h3>\n            <p className=\"text-xs text-slate-400 mt-1\">Estimativas obtidas atrav\303\251s do balan\303\247o estrito do consumo aer\303\263bico est\303\241vel por tempo de esfor\303\247o.</p>\n          </div>\n\n          <div id=\"predictions-card-grid\" className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {predictions.map(pred => {\n              const currentPaceSec = pred.totalSeconds / (pred.distanceMeters / 1000);\n              // Calculate percent of relative velocity for visual bar\n              const percentBar = Math.round(((maxPaceSec - currentPaceSec) / (maxPaceSec - minPaceSec || 1)) * 105);\n\n              return (\n                <div \n                  key={pred.name} \n                  className=\"border border-white/10 bg-white/5 hover:bg-white/10 hover:shadow-xl hover:border-vdot-orange/50 rounded-xl p-4 space-y-3 transition flex flex-col justify-between\"\n                >\n                  <div className=\"flex justify-between items-start\">\n                    <div>\n                      <div className=\"text-xs font-bold text-vdot-orange font-mono tracking-wider uppercase\">{pred.name}</div>\n                      <div className=\"text-xs text-slate-400 mt-0.5 font-semibold\">{(pred.distanceMeters / 1000).toFixed(2)} km</div>\n                    </div>\n                    <div className=\"bg-white/5 text-white border border-white/10 px-2 py-1 rounded-lg text-xs font-mono font-bold flex items-center space-x-1.5 shadow-sm\">\n                      <Clock className=\"w-3.5 h-3.5 text-vdot-orange\" />\n                      <span>{pred.paceStr}</span>\n                    </div>\n                  </div>\n\n                  <div className=\"pt-2\">\n                    <div className=\"text-2xl font-black text-white font-mono\">{pred.timeStr}</div>\n                  </div>\n\n                  {/* Relative Speed Progress bar */}\n                  <div className=\"space-y-1\">\n                    <div className=\"flex justify-between text-[10px] text-slate-400 font
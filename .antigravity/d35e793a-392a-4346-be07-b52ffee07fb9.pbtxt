        }
        lines {
          text: "export function estimateVO2MaxCooper(distanceMeters: number): number {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return (distanceMeters - 504.9) / 44.73;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function estimateVO2Max2400m(timeSeconds: number): number {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const minutes = timeSeconds / 60;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }

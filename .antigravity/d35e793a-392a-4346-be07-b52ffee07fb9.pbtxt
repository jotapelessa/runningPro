    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { RunnerState } from \'./types\';\nimport { \n  calculatePaceZones, \n  getKarvonenZones, \n  getPredictions, \n  generate8WeekPlan \n} from \'./lib/vdot\';\nimport CalculatorTab from \'./components/CalculatorTab\';\nimport PredictorTab from \'./components/PredictorTab\';\nimport PlanTab from \'./components/PlanTab\';\nimport RecoveryTab from \'./components/RecoveryTab\';\nimport CoachChat from \'./components/CoachChat\';\nimport { \n  Flame, \n  Compass, \n  TrendingUp, \n  Calendar, \n  Heart, \n  HelpCircle, \n  Sparkles,\n  Info\n} from \'lucide-react\';\n\nexport default function App() {\n  // Initialize with exact example data from instructions:\n  // FCmax 190, FCR 55, corre 5k em 22:30 (VDOT \342\211\210 41.8)\n  const [runnerState, setRunnerState] = useState<RunnerState>({\n    macHR: 190,\n    restHR: 55,\n    level: \'intermediate\',\n    weeklyVolume: 40,\n    weeksActive: 8,\n    currentVdot: 41.8,\n    currentVo2max: 42.6,\n    history: []\n  });\n\n  const [activeTab, setActiveTab] = useState<\'calculator\' | \'plan\' | \'predictor\' | \'recovery\'>(\'calculator\');\n\n  // Procedurally calculate derived attributes using memozations\n  const paceZones = useMemo(() => calculatePaceZones(runnerState.currentVdot), [runnerState.currentVdot]);\n  const hrZones = useMemo(() => getKarvonenZones(runnerState.macHR, runnerState.restHR), [runnerState.macHR, runnerState.restHR]);\n  const predictions = useMemo(() => getPredictions(runnerState.currentVdot), [runnerState.currentVdot]);\n  \n  const planWeeks = useMemo(() => {\n    return generate8WeekPlan(\n      runnerState.currentVdot, \n      runnerState.level, \n      runnerState.weeklyVolume, \n      runnerState.weeksActive, \n      runnerState.macHR, \n      runnerState.restHR\n    );\n  }, [runnerState.currentVdot, runnerState.level, runnerState.weeklyVolume, runnerState.weeksActive, runnerState.macHR, runnerState.restHR]);\n\n  return (\n    <div className=\"min-h-screen flex flex-col font-sans bg-slate-50/65 selection:bg-indigo-500 selection:text-white\">\n      \n      {/* Top Professional Header */}\n      <header className=\"bg-white border-b border-gray-100 py-4 px-6 sticky top-0 z-40 shadow-xs shrink-0\">\n        <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-3\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"bg-indigo-600 text-white rounded-xl p-2.5 flex items-center justify-center font-display font-black text-xl tracking-tight shadow-md shadow-indigo-600/20\">\n              \342\232\241 PL\n            </div>\n            <div>\n              <h1 className=\"text-lg font-bold font-display uppercase tracking-tight text-slate-900 flex items-center gap-1.5 leading-none\">\n                PaceLab VDOT\n                <span className=\"text-[10px] lowercase font-normal px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 font-mono font-bold tracking-normal\">v3.5</span>\n              </h1>\n              <p className=\"text-[11px] text-gray-400 font-semibold mt-0.5 uppercase tracking-wider\">Treinador Port\303\241til & Calculadora de Corrida Procedimental</p>\n            </div>\n          </div>\n\n          {/* Quick Stats Strip */}\n          <div className=\"flex flex-wrap items-center gap-2 bg-gray-50 border border-gray-100 p-1.5 rounded-xl text-xs font-mono font-bold text-gray-700 select-none\">\n            <span className=\"px-2.5 py-1 bg-white rounded-lg border border-gray-150/45 text-slate-800 shadow-3xs\">\n              VDOT: <span className=\"text-indigo-600\">{runnerState.currentVdot.toFixed(1)}</span>\n            </span>\n            <span className=\"px-2.5 py-1 bg-white rounded-lg border border-gray-150/45 text-slate-800 shadow-3xs capitalize\">\n              {runnerState.level}\n            </span>\n            <span className=\"px-2.5 py-1 bg-white rounded-lg border border-gray-150/45 text-slate-800 shadow-3xs\">\n              Vol: <span className=\"text-indigo-600\">{runnerState.weeklyVolume} km/s</span>\n            </span>\n            <span className=\"px-2.5 py-1 bg-white rounded-lg border border-gray-150/45 text-slate-800 shadow-3xs\">\n              FCM: <span className=\"text-red-500\">{runnerState.macHR} bpm</span>\n            </span>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Layout Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        \n        {/* Left Side: Interactive Labs Dashboard (Tabs) */}\n        <div id=\"calculator-tab-view\" className=\"lg:col-span-8 space-y-6\">\n          \n          {/* Tabs selectors bar */}\n          <div className=\"bg-white border border-gray-100 rounded-xl p-1.5 flex flex-wrap gap-1.5 shadow-3xs\">\n            <button\n              onClick={() => setActiveTab(\'calculator\')}\n              className={`flex items-center space-x-2 px-4 py-2.5 rounded-lg text-xs font-bold transition duration-150 cursor-pointer ${\n                activeTab === \'calculator\' \n                  ? \'bg-indigo-600 text-white shadow-sm\' \n                  : \'text-gray-500 hover:text-gray-800 hover:bg-gray-55 hover:bg-gray-50\'\n              }`}\n            >\n              <Compass className=\"w-4 h-4\" />\n              <span>Calculadora de Zonas</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'plan\')}\n              className={`flex items-center space-x-2 px-4 py-2.5 rounded-lg text-xs font-bold transition duration-150 cursor-pointer ${\n                activeTab === \'plan\' \n                  ? \'bg-indigo-600 text-white shadow-sm\' \n                  : \'text-gray-500 hover:text-gray-800 hover:bg-gray-55 hover:bg-gray-50\'\n              }`}\n            >\n              <Calendar className=\"w-4 h-4\" />\n              <span>Planilha de 8 Semanas</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'predictor\')}\n              className={`flex items-center space-x-2 px-4 py-2.5 rounded-lg text-xs font-bold transition duration-150 cursor-pointer ${\n                activeTab === \'predictor\' \n                  ? \'bg-indigo-600 text-white shadow-sm\' \n                  : \'text-gray-500 hover:text-gray-800 hover:bg-gray-55 hover:bg-gray-50\'\n              }`}\n            >\n              <TrendingUp className=\"w-4 h-4\" />\n              <span>Performance e Previs\303\265es</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'recovery\')}\n              className={`flex items-center space-x-2 px-4 py-2.5 rounded-lg text-xs font-bold transition duration-150 cursor-pointer ${\n                activeTab === \'recovery\' \n                  ? \'bg-indigo-600 text-white shadow-sm\' \n                  : \'text-gray-500 hover:text-gray-800 hover:bg-gray-55 hover:bg-gray-50\'\n              }`}\n            >\n              <Heart className=\"w-4 h-4\" />\n              <span>Preven\303\247\303\243o e Recupera\303\247\303\243o</span>\n            </button>\n          </div>\n\n          {/* Active Tab rendering */}\n          <div id=\"labs-view-content\" className=\"transition-all duration-300\">\n            {activeTab === \'calculator\' && (\n              <CalculatorTab \n                runnerState={runnerState}\n                setRunnerState={setRunnerState}\n                paceZones={paceZones}\n                hrZones={hrZones}\n              />\n            )}\n            {activeTab === \'plan\' && (\n              <PlanTab \n                planWeeks={planWeeks}\n                runnerState={runnerState}\n              />\n            )}\n            {activeTab === \'predictor\' && (\n              <PredictorTab \n                predictions={predictions}\n                vdot={runnerState.currentVdot}\n              />\n            )}\n            {activeTab === \'recovery\' && (\n              <RecoveryTab />\n            )}\n          </div>\n        </div>\n\n        {/* Right Side: Coach Chat Assist Sidebar */}\n        <div id=\"ai-coach-sidebar-container\" className=\"lg:col-span-4 lg:sticky lg:top-[90px] xl:col-span-4\">\n          <CoachChat \n            runnerState={runnerState}\n            activePlan={planWeeks}\n          />\n          \n          <div className=\"mt-4 bg-white/70 rounded-xl p-4 border border-gray-100 flex items-start space-x-2.5 shadow-3xs\">\n            <Info className=\"w-4 h-4 text-indigo-500 shrink-0 mt-0.5\" />\n            <p className=\"text-[10px] text-gray-500 font-sans leading-relaxed\">\n              <strong>Como calibrar os dados:</strong> Ajuste seu peso aer\303\263bico e volume semanal na aba <em>Calculadora de Zonas</em>. A planilha de 8 semanas, ritmos de equival\303\252ncia e a base de conhecimento do Coach se auto-reorganizar\303\243o instantaneamente!\n            </p>\n          </div>\n        </div>\n\n      </main>\n\n      <footer className=\"bg-white border-t border-gray-100 text-center py-6 text-xs text-gray-400 mt-auto shrink-0\">\n        <p className=\"max-w-2xl mx-auto px-4 font-semibold uppercase tracking-wider\">\n          PaceLab VDOT \342\200\242 Baseado no Oxygen Power Training de Jack Daniels\n        </p>\n        <p className=\"text-[10px] text-gray-400 mt-1 max-w-sm mx-auto\">\n          Equa\303\247\303\265es de Jack Daniels parametrizadas via solver quadr\303\241tico estrito. Preserve sua integridade f\303\255sica ouvindo sempre seu corpo.\n        </p>\n      </footer>\n\n    </div>\n  );\n}\n"
    }
